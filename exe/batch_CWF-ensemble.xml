<?xml version="1.0" encoding="UTF-8"?>
<BatchRunner xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="batch_runner.xsd">



<ComponentSet name="policy">
<FileSet name="_constraint_updated">
            <!--Policy-->
			<Value name = "constraint">../input/extra/developments_working/extra_CO2_constraint_tests/constraint_CO2_test_2025_update.xml</Value>
			<Value name="region_nz_adjust">../input/extra/proportional_tax_rate_cwf.xml</Value>
			<Value name="luc_price">../input/extra/nature_cdr/global_uct_cwf.xml</Value>
</FileSet>


</ComponentSet>

<ComponentSet name="ensemble">

	<FileSet name="central">
	</FileSet>

	<FileSet name="highERW">
			<Value name = "ew_growthlim">../input/gcamdata/xml/Weathering_high.xml</Value>
	</FileSet>

	<FileSet name="lowERW">
			<Value name = "ew_growthlim">../input/gcamdata/xml/Weathering_low.xml</Value>
	</FileSet>


	<FileSet name="highCCS">
			<Value name = "cstorage_constraint">../input/extra/ccs_constraint/cwf_high_cstorage_constraint.xml</Value>
 	 		<Value name = "cstorage_mkt">../input/extra/ccs_constraint/cstorage_ceiling_mkt.xml</Value>
	</FileSet>

	<FileSet name="lowCCS">
			<Value name = "cstorage_constraint">../input/extra/ccs_constraint/cwf_low_cstorage_constraint.xml</Value>
 	 		<Value name = "cstorage_mkt">../input/extra/ccs_constraint/cstorage_ceiling_mkt.xml</Value>
	</FileSet>

	<FileSet name="high_naturalCDR">
			<Value name = "ew_growthlim">../input/extra/nature_cdr/global_uct_high-LUC-CDR.xml</Value>
	</FileSet>

	<FileSet name="low_naturalCDR">
			<Value name = "ew_growthlim">../input/policy/global_ffict.xml</Value>
	</FileSet>

	<FileSet name="highBio">
			<Value name = "bio_constraint">../input/extra/bio_constraint/cwf_high_bio_constraint.xml</Value>
 	 		<Value name = "bio_mkt">../input/extra/bio_constraint/bio_ceiling_mkt.xml</Value>
	</FileSet>

	<FileSet name="lowBio">
			<Value name = "bio_constraint">../input/extra/bio_constraint/cwf_low_bio_constraint.xml</Value>
 	 		<Value name = "bio_mkt">../input/extra/bio_constraint/bio_ceiling_mkt.xml</Value>
	</FileSet>

	<FileSet name="lowH2">
			<Value name = "trn_lowH2">../input/gcamdata/xml/transportation_UCD_cwf_low_H2.xml</Value>
			<Value name = "iron_steel_lowH2">../input/gcamdata/xml/iron_steel_cwf_low_H2.xml</Value>
